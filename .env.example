# API keys (comma separated)
GEMINI_API_KEYS=key1,key2,key3

# Admin token for /status and /reload-keys
ADMIN_TOKEN=changeme_local_only

# Upstream Gemini API base URL
# UPSTREAM_BASE=https://generativelanguage.googleapis.com/v1beta

# Optional: HTTP proxy URL for bypassing regional restrictions
# VPN_PROXY_URL=192.168.1.103:2080
# Proxy credentials
# PROXY_USERNAME=DOMAIN\username
# PROXY_PASSWORD=p@ss&word

# Error backoff configuration
# BACKOFF_MIN=5.0
# BACKOFF_MAX=600.0

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
